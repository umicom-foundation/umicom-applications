{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "headless-debug",
      "displayName": "Portable headless Debug",
      "description": "Build Framework, Desk runtime, Studio, Trader, Bank, TMS, OS Control Centre and tests without GTK4.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/headless-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "BUILD_TESTING": "ON",
        "UMICOM_APPLICATIONS_BUILD_DESKTOP": "ON",
        "UMICOM_APPLICATIONS_BUILD_STUDIO": "ON",
        "UMICOM_APPLICATIONS_BUILD_OS": "ON",
        "UMICOM_APPLICATIONS_BUILD_TRADER": "ON",
        "UMICOM_APPLICATIONS_BUILD_TMS": "ON",
        "UMICOM_APPLICATIONS_BUILD_LLM": "OFF",
        "UMICOM_APPLICATIONS_BUILD_BANK": "ON",
        "UMICOM_APPLICATIONS_BUILD_EXCHANGE": "OFF",
        "UMICOM_DESKTOP_BUILD_GTK": "OFF",
        "UMICOM_STUDIO_BUILD_GTK": "OFF",
        "UMICOM_TRADER_BUILD_GTK4": "OFF",
        "UMICOM_BANK_BUILD_GTK4": "OFF",
        "UMICOM_TMS_BUILD_GTK4": "OFF",
        "UMICOM_MUSIC_STUDIO_BUILD_GTK4": "OFF",
        "UMICOM_APPLICATIONS_BUILD_SHARED_GTK4": "OFF",
        "UMICOM_ENABLE_STRICT_WARNINGS": "ON",
        "UMICOM_APPLICATIONS_BUILD_ALL_MODULES": "OFF"
      }
    },
    {
      "name": "windows-ucrt64-headless-debug",
      "displayName": "Windows MSYS2 UCRT64 GCC headless Debug",
      "description": "Canonical Windows GCC/UCRT64 headless validation of Framework, Desk, Studio, Trader, Bank, TMS and OS Control Centre.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-ucrt64-headless-debug",
      "environment": {
        "PATH": "C:/msys64/ucrt64/bin;$penv{PATH}"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "C:/msys64/ucrt64/bin/gcc.exe",
        "CMAKE_ASM_COMPILER": "C:/msys64/ucrt64/bin/gcc.exe",
        "CMAKE_RC_COMPILER": "C:/msys64/ucrt64/bin/windres.exe",
        "CMAKE_MAKE_PROGRAM": "C:/msys64/ucrt64/bin/ninja.exe",
        "CMAKE_EXE_LINKER_FLAGS": "-Wl,--stack,67108864",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "PKG_CONFIG_EXECUTABLE": "C:/msys64/ucrt64/bin/pkg-config.exe",
        "CMAKE_PREFIX_PATH": "C:/msys64/ucrt64",
        "BUILD_TESTING": "ON",
        "UMICOM_APPLICATIONS_BUILD_DESKTOP": "ON",
        "UMICOM_APPLICATIONS_BUILD_STUDIO": "ON",
        "UMICOM_APPLICATIONS_BUILD_OS": "ON",
        "UMICOM_APPLICATIONS_BUILD_TRADER": "ON",
        "UMICOM_APPLICATIONS_BUILD_TMS": "ON",
        "UMICOM_APPLICATIONS_BUILD_LLM": "OFF",
        "UMICOM_APPLICATIONS_BUILD_BANK": "ON",
        "UMICOM_APPLICATIONS_BUILD_EXCHANGE": "OFF",
        "UMICOM_DESKTOP_BUILD_GTK": "OFF",
        "UMICOM_STUDIO_BUILD_GTK": "OFF",
        "UMICOM_TRADER_BUILD_GTK4": "OFF",
        "UMICOM_BANK_BUILD_GTK4": "OFF",
        "UMICOM_TMS_BUILD_GTK4": "OFF",
        "UMICOM_MUSIC_STUDIO_BUILD_GTK4": "OFF",
        "UMICOM_APPLICATIONS_BUILD_SHARED_GTK4": "OFF",
        "UMICOM_ENABLE_STRICT_WARNINGS": "ON",
        "UMICOM_APPLICATIONS_BUILD_ALL_MODULES": "OFF"
      }
    },
    {
      "name": "windows-ucrt64-debug",
      "displayName": "Windows MSYS2 UCRT64 GCC GTK4 Debug",
      "description": "Canonical Windows GCC/UCRT64 GTK4 build of Umicom Desk, Framework, Studio, Trader, Bank, TMS and OS Control Centre.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-ucrt64-debug",
      "environment": {
        "PATH": "C:/msys64/ucrt64/bin;$penv{PATH}"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "C:/msys64/ucrt64/bin/gcc.exe",
        "CMAKE_ASM_COMPILER": "C:/msys64/ucrt64/bin/gcc.exe",
        "CMAKE_RC_COMPILER": "C:/msys64/ucrt64/bin/windres.exe",
        "CMAKE_MAKE_PROGRAM": "C:/msys64/ucrt64/bin/ninja.exe",
        "CMAKE_EXE_LINKER_FLAGS": "-Wl,--stack,67108864",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "PKG_CONFIG_EXECUTABLE": "C:/msys64/ucrt64/bin/pkg-config.exe",
        "CMAKE_PREFIX_PATH": "C:/msys64/ucrt64",
        "BUILD_TESTING": "ON",
        "UMICOM_APPLICATIONS_BUILD_DESKTOP": "ON",
        "UMICOM_APPLICATIONS_BUILD_STUDIO": "ON",
        "UMICOM_APPLICATIONS_BUILD_OS": "ON",
        "UMICOM_APPLICATIONS_BUILD_TRADER": "ON",
        "UMICOM_APPLICATIONS_BUILD_TMS": "ON",
        "UMICOM_APPLICATIONS_BUILD_LLM": "OFF",
        "UMICOM_APPLICATIONS_BUILD_BANK": "ON",
        "UMICOM_APPLICATIONS_BUILD_EXCHANGE": "OFF",
        "UMICOM_DESKTOP_BUILD_GTK": "ON",
        "UMICOM_DESKTOP_GUI": "ON",
        "UMICOM_STUDIO_BUILD_GTK": "ON",
        "UMICOM_STUDIO_GUI": "ON",
        "UMICOM_TRADER_BUILD_GTK4": "ON",
        "UMICOM_BANK_BUILD_GTK4": "ON",
        "UMICOM_TMS_BUILD_GTK4": "ON",
        "UMICOM_MUSIC_STUDIO_BUILD_GTK4": "ON",
        "UMICOM_APPLICATIONS_BUILD_SHARED_GTK4": "ON",
        "UMICOM_APPLICATIONS_STAGE_FRAMEWORK_RESOURCES": "ON",
        "UMICOM_ENABLE_STRICT_WARNINGS": "ON",
        "UMICOM_APPLICATIONS_BUILD_ALL_MODULES": "OFF"
      }
    },
    {
      "name": "windows-ucrt64-all-debug",
      "displayName": "Windows MSYS2 UCRT64 GCC all modules Debug",
      "description": "Build the complete checked-in Umicom application module estate with the canonical Windows GCC/UCRT64 GTK4 configuration.",
      "inherits": "windows-ucrt64-debug",
      "binaryDir": "${sourceDir}/build/windows-ucrt64-all-debug",
      "cacheVariables": {
        "UMICOM_APPLICATIONS_BUILD_ALL_MODULES": "ON"
      }
    },
    {
      "name": "linux-all-headless-debug",
      "displayName": "Linux Clang all modules headless Debug",
      "description": "Native Linux all-module qualification without GTK4; retains the portable headless baseline.",
      "inherits": "headless-debug",
      "binaryDir": "${sourceDir}/build/linux-all-headless-debug",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "UMICOM_APPLICATIONS_BUILD_ALL_MODULES": "ON"
      }
    },
    {
      "name": "linux-gcc-all-headless-debug",
      "displayName": "Linux GCC all modules headless Debug",
      "description": "Independent GCC build tree for the same Linux headless application portfolio.",
      "inherits": "linux-all-headless-debug",
      "binaryDir": "${sourceDir}/build/linux-gcc-all-headless-debug",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc"
      }
    },
    {
      "name": "windows-ucrt64-all-headless-debug",
      "displayName": "Windows UCRT64 GCC all modules headless Debug",
      "description": "All-module headless Windows qualification separate from GTK4 presentation.",
      "inherits": "windows-ucrt64-headless-debug",
      "binaryDir": "${sourceDir}/build/windows-ucrt64-all-headless-debug",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "UMICOM_APPLICATIONS_BUILD_ALL_MODULES": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "headless-debug",
      "configurePreset": "headless-debug"
    },
    {
      "name": "windows-ucrt64-headless-debug",
      "configurePreset": "windows-ucrt64-headless-debug"
    },
    {
      "name": "windows-ucrt64-debug",
      "configurePreset": "windows-ucrt64-debug"
    },
    {
      "name": "windows-ucrt64-all-debug",
      "configurePreset": "windows-ucrt64-all-debug"
    },
    {
      "name": "linux-all-headless-debug",
      "configurePreset": "linux-all-headless-debug",
      "jobs": 2
    },
    {
      "name": "linux-gcc-all-headless-debug",
      "configurePreset": "linux-gcc-all-headless-debug",
      "jobs": 2
    },
    {
      "name": "windows-ucrt64-all-headless-debug",
      "configurePreset": "windows-ucrt64-all-headless-debug",
      "jobs": 2
    }
  ],
  "testPresets": [
    {
      "name": "headless-debug",
      "configurePreset": "headless-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-ucrt64-headless-debug",
      "configurePreset": "windows-ucrt64-headless-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-ucrt64-debug",
      "configurePreset": "windows-ucrt64-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-ucrt64-all-debug",
      "configurePreset": "windows-ucrt64-all-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-all-headless-debug",
      "configurePreset": "linux-all-headless-debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 2,
        "noTestsAction": "error"
      }
    },
    {
      "name": "linux-gcc-all-headless-debug",
      "configurePreset": "linux-gcc-all-headless-debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 2,
        "noTestsAction": "error"
      }
    },
    {
      "name": "windows-ucrt64-all-headless-debug",
      "configurePreset": "windows-ucrt64-all-headless-debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 2,
        "noTestsAction": "error"
      }
    }
  ]
}
