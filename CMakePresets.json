{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "headless-debug",
      "displayName": "Portable headless Debug",
      "description": "Build Framework, StudioCore, Studio command tools and tests without GTK4.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/headless-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "BUILD_TESTING": "ON",
        "UMICOM_APPLICATIONS_BUILD_STUDIO": "ON",
        "UMICOM_APPLICATIONS_BUILD_TRADER": "OFF",
        "UMICOM_APPLICATIONS_BUILD_TMS": "OFF",
        "UMICOM_APPLICATIONS_BUILD_LLM": "OFF",
        "UMICOM_APPLICATIONS_BUILD_BANK": "OFF",
        "UMICOM_APPLICATIONS_BUILD_EXCHANGE": "OFF",
        "UMICOM_STUDIO_BUILD_GTK": "OFF",
        "UMICOM_ENABLE_STRICT_WARNINGS": "ON"
      }
    },
    {
      "name": "windows-ucrt64-headless-debug",
      "displayName": "Windows MSYS2 UCRT64 headless Debug",
      "description": "Canonical Windows headless validation using the UCRT64 Clang and Ninja toolchain.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-ucrt64-headless-debug",
      "environment": {
        "PATH": "C:/msys64/ucrt64/bin;$penv{PATH}"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "C:/msys64/ucrt64/bin/clang.exe",
        "CMAKE_MAKE_PROGRAM": "C:/msys64/ucrt64/bin/ninja.exe",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "PKG_CONFIG_EXECUTABLE": "C:/msys64/ucrt64/bin/pkg-config.exe",
        "CMAKE_PREFIX_PATH": "C:/msys64/ucrt64",
        "BUILD_TESTING": "ON",
        "UMICOM_APPLICATIONS_BUILD_STUDIO": "ON",
        "UMICOM_APPLICATIONS_BUILD_TRADER": "OFF",
        "UMICOM_APPLICATIONS_BUILD_TMS": "OFF",
        "UMICOM_APPLICATIONS_BUILD_LLM": "OFF",
        "UMICOM_APPLICATIONS_BUILD_BANK": "OFF",
        "UMICOM_APPLICATIONS_BUILD_EXCHANGE": "OFF",
        "UMICOM_STUDIO_BUILD_GTK": "OFF",
        "UMICOM_ENABLE_STRICT_WARNINGS": "ON"
      }
    },
    {
      "name": "windows-ucrt64-debug",
      "displayName": "Windows MSYS2 UCRT64 GTK4 Debug",
      "description": "Canonical Windows GTK4 build of Framework and the Studio application module.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-ucrt64-debug",
      "environment": {
        "PATH": "C:/msys64/ucrt64/bin;$penv{PATH}"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "C:/msys64/ucrt64/bin/clang.exe",
        "CMAKE_RC_COMPILER": "C:/msys64/ucrt64/bin/windres.exe",
        "CMAKE_MAKE_PROGRAM": "C:/msys64/ucrt64/bin/ninja.exe",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "PKG_CONFIG_EXECUTABLE": "C:/msys64/ucrt64/bin/pkg-config.exe",
        "CMAKE_PREFIX_PATH": "C:/msys64/ucrt64",
        "BUILD_TESTING": "ON",
        "UMICOM_APPLICATIONS_BUILD_STUDIO": "ON",
        "UMICOM_APPLICATIONS_BUILD_TRADER": "OFF",
        "UMICOM_APPLICATIONS_BUILD_TMS": "OFF",
        "UMICOM_APPLICATIONS_BUILD_LLM": "OFF",
        "UMICOM_APPLICATIONS_BUILD_BANK": "OFF",
        "UMICOM_APPLICATIONS_BUILD_EXCHANGE": "OFF",
        "UMICOM_STUDIO_BUILD_GTK": "ON",
        "UMICOM_STUDIO_GUI": "ON",
        "UMICOM_APPLICATIONS_REQUIRE_STUDIO_RESOURCES": "ON",
        "UMICOM_ENABLE_STRICT_WARNINGS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "headless-debug",
      "configurePreset": "headless-debug"
    },
    {
      "name": "windows-ucrt64-headless-debug",
      "configurePreset": "windows-ucrt64-headless-debug"
    },
    {
      "name": "windows-ucrt64-debug",
      "configurePreset": "windows-ucrt64-debug"
    }
  ],
  "testPresets": [
    {
      "name": "headless-debug",
      "configurePreset": "headless-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-ucrt64-headless-debug",
      "configurePreset": "windows-ucrt64-headless-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-ucrt64-debug",
      "configurePreset": "windows-ucrt64-debug",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
