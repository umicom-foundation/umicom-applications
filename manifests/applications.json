{
  "schema": "umicom.applications/2",
  "repository": "umicom-foundation/umicom-applications",
  "runtime_product": "Umicom Desk",
  "framework": {
    "id": "umicom.framework",
    "path": "framework",
    "repository": "umicom-foundation/umicom-framework",
    "required": true,
    "resource_catalogue": "framework/resources/resource-catalogue.json"
  },
  "applications": [
    {
      "id": "org.umicom.studio",
      "path": "applications/studio",
      "repository": "umicom-foundation/umicom-studio-ide-module",
      "status": "active",
      "default_enabled": true,
      "entry_kind": "workbench",
      "taskbar_group": "development",
      "icon_resource_id": "umicom.icon.application.studio",
      "default_layout_id": "develop"
    },
    {
      "id": "org.umicom.trader",
      "path": "applications/trader",
      "repository": "umicom-foundation/umicom-trader-module",
      "status": "placeholder",
      "default_enabled": false,
      "entry_kind": "workbench",
      "taskbar_group": "finance",
      "icon_resource_id": "umicom.icon.application.trader",
      "default_layout_id": "trading"
    },
    {
      "id": "org.umicom.tms",
      "path": "applications/tms",
      "repository": "umicom-foundation/umicom-tms-module",
      "status": "placeholder",
      "default_enabled": false,
      "entry_kind": "workbench",
      "taskbar_group": "finance",
      "icon_resource_id": "umicom.icon.application.tms",
      "default_layout_id": "treasury"
    },
    {
      "id": "org.umicom.llm",
      "path": "applications/llm",
      "repository": "umicom-foundation/umicom-llm-module",
      "status": "placeholder",
      "default_enabled": false,
      "entry_kind": "workbench",
      "taskbar_group": "artificial-intelligence",
      "icon_resource_id": "umicom.icon.application.llm",
      "default_layout_id": "ai"
    },
    {
      "id": "org.umicom.bank",
      "path": "applications/bank",
      "repository": "umicom-foundation/umicom-bank-module",
      "status": "placeholder",
      "default_enabled": false,
      "entry_kind": "workbench",
      "taskbar_group": "finance",
      "icon_resource_id": "umicom.icon.application.bank",
      "default_layout_id": "banking"
    },
    {
      "id": "org.umicom.exchange",
      "path": "applications/exchange",
      "repository": "umicom-foundation/umicom-exchange-module",
      "status": "placeholder",
      "default_enabled": false,
      "entry_kind": "workbench",
      "taskbar_group": "finance",
      "icon_resource_id": "umicom.icon.application.exchange",
      "default_layout_id": "exchange"
