#-----------------------------------------------------------------------------
# Umicom Applications
# File: .gitattributes
#
# PURPOSE:
#   Keep source, build definitions and documentation stable across Windows and
#   Unix checkouts while leaving binary application resources untouched.
#
# AUTHOR AND ORGANISATION:
#   Sammy Hegab
#   Umicom Foundation
#
# LICENCE:
#   MIT
#-----------------------------------------------------------------------------
* text=auto

*.c       text eol=lf
*.cc      text eol=lf
*.cpp     text eol=lf
*.h       text eol=lf
*.hpp     text eol=lf
*.cmake   text eol=lf
CMakeLists.txt text eol=lf
*.json    text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.md      text eol=lf
*.txt     text eol=lf
*.html    text eol=lf
*.css     text eol=lf
*.js      text eol=lf
*.ts      text eol=lf
*.sh      text eol=lf

*.bat     text eol=crlf
*.cmd     text eol=crlf
*.ps1     text eol=crlf
*.sln     text eol=crlf
*.vcxproj text eol=crlf
*.filters text eol=crlf
*.props   text eol=crlf
*.targets text eol=crlf

*.png  -text
*.jpg  -text
*.jpeg -text
*.gif  -text
*.ico  -text
*.pdf  -text
*.docx -text
*.zip  -text
*.7z   -text
*.exe  -text
*.dll  -text
*.lib  -text
*.pdb  -text
